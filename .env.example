# ======================================================
# J.A.R.V.I.S. CONFIGURATION
# ======================================================

# Google Gemini API Key (Optional - required only for Gemini Cloud mode)
# Acquire a free key at: https://aistudio.google.com/apikey
# If left empty, J.A.R.V.I.S. operates 100% offline using local Ollama models.
GOOGLE_API_KEY=your_gemini_api_key_here

# Local Server Port (Default: 3000)
PORT=3000
